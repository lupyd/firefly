# Copy to .env (bots-setup.ts does this) and fill in the bot's Lupyd account.
# Use a separate email + password account, not your own and not a Google login.
BOT_EMAIL=
BOT_PASSWORD=

# Optional overrides
# BOT_SESSION_FILE=./reminder-session.json
# BOT_DB_FILE=./reminder-state.db
# REMINDERS_DB=./reminders.db
