{
  "name": "firefly-protos-js",
  "version": "0.1.0",
  "description": "Generated protobuf definitions and codecs for the Firefly MLS network",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "proto:gen": "mkdir -p src && protoc -I=../protos/protobufs message.proto --plugin=node_modules/ts-proto/protoc-gen-ts_proto --ts_proto_opt=forceLong=bigint --ts_proto_opt=env=node --ts_proto_opt=esModuleInterop=true --ts_proto_out=src",
    "build": "pnpm run proto:gen && tsc",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "protobufjs": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-proto": "^2.7.5",
    "typescript": "latest"
  }
}
