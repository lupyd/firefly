{
  "name": "firefly-protos-js",
  "version": "0.0.6",
  "description": "Generated protobuf definitions and codecs for the Firefly MLS network",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupyd/firefly.git"
  },
  "bugs": {
    "url": "https://github.com/lupyd/firefly/issues"
  },
  
  "scripts": {
    "proto:gen": "mkdir -p src && protoc -I=../protos/protobufs message.proto --plugin=node_modules/ts-proto/protoc-gen-ts_proto --ts_proto_opt=forceLong=bigint --ts_proto_opt=env=browser --ts_proto_opt=esModuleInterop=true --ts_proto_out=src",
    "build": "pnpm run proto:gen && tsc",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "protobufjs": "^8.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-proto": "^2.12.0",
    "typescript": "^7.0.2"
  }
}
